{
  // Type-check the JavaScript modules (no build output). Run with `npm run typecheck` (uses the tsc on PATH).
  // Modules are added here as they get JSDoc types; the inline script in index.html is checked by build + lint.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["types/**/*.d.ts", "books.js", "filing.js", "ocr.js", "imports.js", "tips.js", "engine/**/*.js", "document-intelligence/**/*.js"]
}
